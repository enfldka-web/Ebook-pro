# 2026-08-13: 썸네일 AI 이미지 생성 기능(OpenAI 연동)이 완전히 제거되어
# OPENAI_API_KEY 관련 설정은 더 이상 필요하지 않습니다(제거됨).

# 자료 분석/제목 생성/전자책 생성(js/anthropic-gateway-client.js가 호출하는 모든 것)에
# 필요합니다 — 이 변수가 없으면 "Anthropic API 키가 설정되지 않았습니다" 상태로 남습니다.
ANTHROPIC_API_KEY=
ANTHROPIC_TEXT_TIMEOUT_MS=120000
ANTHROPIC_CHAPTER_TIMEOUT_MS=300000

# 2026-08-13: 무료체험/플랜 한도를 익명 세션 기준으로 추적하던
# image-usage-store.js가 삭제되어(실제 로그인 계정 기준 DB 추적으로 교체)
# ATLAS_PLAN_* 한도 설정은 더 이상 필요하지 않습니다(제거됨).

# 2026-08-13: 실제 회원가입/로그인/구독 상태를 저장하는 PostgreSQL 접속 문자열.
# 로컬 개발 예시: postgresql://postgres:비밀번호@localhost:5432/atlas_dev
# Render에 배포할 때는 render.yaml의 databases: 블록에서 자동으로 채워집니다.
# 이 값이 없으면 /api/auth/* 라우트가 503(설정 안 됨)으로 응답합니다.
DATABASE_URL=

# JWT 서명에 쓰는 서버 전용 비밀 값입니다. 반드시 무작위 문자열로 직접 채우세요
# (예: `openssl rand -hex 32`) — 이 값을 비워두거나 예측 가능한 값으로 두면
# 누구나 로그인 토큰을 위조할 수 있습니다. .env.example에는 절대 실제 값을
# 넣지 않습니다.
JWT_SECRET=

# 토스페이먼츠 정기구독(카드 등록+매달 자동청구, server/providers/
# toss-payments-provider.js). 비워두면 토스가 공식 문서에 공개한 테스트
# 상점 키로 자동 대체됩니다(실제 돈이 움직이지 않는 샌드박스) — 실제 상점
# 키가 발급되면 이 두 값을 채워 넣으세요. TOSS_CLIENT_KEY는 브라우저에도
# 노출되는 공개 값이고, TOSS_SECRET_KEY는 서버에서만 쓰이는 진짜 비밀 값
# 입니다(절대 커밋/노출 금지).
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# 2026-08-14: 여기 적힌 이메일(쉼표로 여러 개 가능, 대소문자 구분 안 함)로
# 가입한 계정은 무료체험 1회 제한/구독 없이 항상 이용할 수 있습니다(운영자
# 본인 계정용). 비워두면 아무도 관리자로 취급되지 않습니다.
ADMIN_EMAILS=

# 회원가입 시 이메일 인증번호 발송(Resend, https://resend.com/api-keys).
# 비워두면 회원가입에서 인증번호 요청이 503(설정 안 됨)으로 응답합니다.
RESEND_API_KEY=
# 발신자 주소. 비워두면 Resend가 도메인 인증 없이 제공하는
# onboarding@resend.dev로 발송됩니다 — 실제 도메인을 Resend에 인증해두면
# 그 도메인의 주소로 바꿀 수 있습니다.
RESEND_FROM_EMAIL=

# 2026-08-21: 서버 장애/결제 실패를 실시간으로 알림받기 위한 범용 웹훅
# URL(Slack/Discord Incoming Webhook 등 {"text":"..."} 형태의 POST를
# 받는 곳이면 무엇이든 가능). 비워두면 지금처럼 서버 로그에만 남습니다
# (기능 자체는 그대로 동작 — 알림만 추가로 안 갈 뿐).
OPS_ALERT_WEBHOOK_URL=

PORT=8910
