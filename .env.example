# 2026-08-11: 전자책 완성 후 썸네일 4테마(베스트셀러 에디토리얼/마켓플레이스
# 임팩트/문제 해결형/퍼블리셔 프리미엄) 배경 이미지 생성용. 이 키가 없으면
# 썸네일 화면의 "AI 이미지 생성" 버튼이 "OpenAI API 키가 설정되지 않았습니다"로
# 남습니다(생성 전에는 기존 고정 배경 미리보기가 그대로 보이므로 화면은 깨지지
# 않습니다). 실제 값은 .env(Git에 커밋하지 않음)에만 넣으세요.
# API Key는 반드시 서버 환경변수로만 읽고, 브라우저 코드/localStorage/Git에 저장하지 않습니다.

OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_TIMEOUT_MS=120000
OPENAI_IMAGE_MAX_CONCURRENCY=2

# 자료 분석/제목 생성/전자책 생성(js/anthropic-gateway-client.js가 호출하는 모든 것)에
# 필요합니다 — 이 변수가 없으면 "Anthropic API 키가 설정되지 않았습니다" 상태로 남습니다.
ANTHROPIC_API_KEY=
ANTHROPIC_TEXT_TIMEOUT_MS=120000
ANTHROPIC_CHAPTER_TIMEOUT_MS=180000

# 플랜별 한도(설정값 — 코드에 하드코딩하지 않음). 비워두면 서버 기본값을 사용합니다.
ATLAS_PLAN_STARTER_DAILY_LIMIT=10
ATLAS_PLAN_STARTER_MONTHLY_LIMIT=100
ATLAS_PLAN_PRO_DAILY_LIMIT=50
ATLAS_PLAN_PRO_MONTHLY_LIMIT=1000
ATLAS_PLAN_ADMIN_DAILY_LIMIT=200
ATLAS_PLAN_ADMIN_MONTHLY_LIMIT=5000

# 실제 비용이 발생하는 OpenAI 통합 테스트를 명시적으로 켤 때만 true로 설정하세요.
RUN_OPENAI_IMAGE_INTEGRATION=false

PORT=8910
